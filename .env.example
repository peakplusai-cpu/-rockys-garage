# 正式環境請改成自己的長密碼。已公開的範例密碼 rocky-admin-2026 在 production 會被拒絕。
ADMIN_PASSWORD=
# 正式環境必填，至少使用一組沒有出現在版本庫的隨機字串。留空或使用 change-me-in-production 時，後台無法登入。
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@rockysgarage
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/rockysgarage

# Supabase (same project as Anson Top Car; use rocky_* tables only).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
# Public: JWT anon (eyJ…) or sb_publishable_…
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server: JWT service_role (eyJ…) or sb_secret_…
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Optional LINE Login for binding staff accounts
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=
